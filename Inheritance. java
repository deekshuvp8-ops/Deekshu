class Vehicle {
    protected String brand = "Ford"; // Accessible by subclasses

    public void honk() {
        System.out.println("Tuut, tuut!");
    }
}

// Child Class (Subclass) inheriting from Vehicle
class Car extends Vehicle {
    private String modelName = "Mustang"; // Subclass attribute

    public void displayInfo() {
        // Accessing inherited field 'brand' and local field 'modelName'
        System.out.println("Brand: " + brand + ", Model: " + modelName);
    }
}

// Main class to test
public class Main {
    public static void main(String[] args) {
        Car myCar = new Car();

        // Calling inherited method from Vehicle
        myCar.honk();

        // Displaying combined information
        myCar.displayInfo();
    }
}