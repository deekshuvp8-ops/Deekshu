public class TwoDimensionalArray {
    public static void main(String[] args) {
        // 1. Declaration and Initialization with fixed values (3x3 Matrix)
        int[][] matrix = {
            {1, 2, 3},
            {4, 5, 6},
            {7, 8, 9}
        };

        // 2. Accessing a specific element (Row 1, Column 2 -> Index 0-based)
        System.out.println("Element at row 1, col 2: " + matrix[0][1]); // Outputs 2

        // 3. Modifying an element
        matrix[2][2] = 99;

        // 4. Traversing using Nested Loops
        System.out.println("\n--- Matrix Elements ---");
        for (int row = 0; row < matrix.length; row++) {
            for (int col = 0; col < matrix[row].length; col++) {
                System.out.print(matrix[row][col] + " ");
            }
            System.out.println(); // New line after each row
        }

        // 5. Alternative traversal using For-Each loop
        System.out.println("\n--- Traversing with For-Each ---");
        for (int[] row : matrix) {
            for (int value : row) {
                System.out.print(value + " ");
            }
            System.out.println();
        }
    }
}